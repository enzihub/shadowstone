# Copied to .env by `ss create`. Leave a value blank to turn that feature off.
ENVIRONMENT=development
APP_NAME=
APP_URL=
PORT=8000

# Postgres (shared with the -web component's docker compose) and Redis
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# AI summaries (Google Gemini)
GEMINI_API_KEY=

# Clerk (to read users' OAuth tokens)
CLERK_SECRET_KEY=

# Error tracking
SENTRY_DSN=

# Email (Mailtrap)
MAILTRAP_API_TOKEN=
EMAIL_SUBJECT=
FROM_EMAIL=
FROM_NAME=
