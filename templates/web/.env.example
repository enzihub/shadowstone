# Copied to .env by `ss create`. Leave a value blank to turn that feature off.

NEXT_PUBLIC_APP_NAME=
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SALES_EMAIL=

# FastAPI core (the -core component)
NEXT_PUBLIC_CORE_API_URL=

# Demo mode: fake Clerk user, fake Stripe plans, no accounts needed. Never enable in production.
NEXT_PUBLIC_DEMO_MODE=

# Database (Postgres through the Neon HTTP driver)
# Local: `docker compose up -d` starts Postgres plus a Neon HTTP proxy on 4444.
DATABASE_URL=
POSTGRES_PASSWORD=
PG_CONNECTION_STRING=
NEON_HTTP_ENDPOINT=
POSTGRES_PORT=5432
NEON_PROXY_PORT=4444

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
SIGNING_SECRET=

# Stripe (https://dashboard.stripe.com/test/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_APP_CODE=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK1=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
